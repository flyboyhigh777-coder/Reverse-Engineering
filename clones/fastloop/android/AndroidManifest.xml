<?xml version="1.0" encoding="utf-8"?>
<!--
  The application id changed from tools.fastloop to app.fastloop at 0.11.2.

  The debug key that signed every build up to 0.10.0 lived only in the build
  container and was lost when that container was recreated. Android refuses an
  update signed by a different certificate, so the old id could only be reused
  after uninstalling, which destroys the app's storage before its records can
  be copied out. A new id installs alongside the old app instead: the records
  can be exported from one and restored into the other, and only then is the
  old app removed. Builds from 0.11.2 on share one deterministic certificate,
  so this is a one-time break, not a habit.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.fastloop"
    android:versionCode="51"
    android:versionName="0.39.0">

  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <!--
    Only the AI camera reaches the network, and only once an API key has been
    entered by hand in the profile. With no key the app makes no requests at
    all; the permission is declared because Android has no way to ask for it
    later, not because anything is sent in the background.
  -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Detents on the tape picker. Not a dangerous permission: no prompt. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!--
    Sleep comes off the watch the only way it can: the watch's own app writes
    what it recorded into Health Connect, and this reads it from there. Read
    only — nothing is ever written back — and nothing is read until the owner
    allows it on Health Connect's own screen, which this app cannot speak for.
  -->
  <uses-permission android:name="android.permission.health.READ_SLEEP" />

  <!--
    Package visibility: without this, Android 11+ hides Health Connect from
    this app and the client reports it as absent on a phone that has it.
  -->
  <queries>
    <package android:name="com.google.android.apps.healthdata" />
    <!--
      The watch apps, so the one that is installed can be found and opened.
      Android 11 and up hides every other app from this one unless it is
      named here: without these the app cannot even tell that Mi Fitness is
      on the phone, let alone offer to open it.
    -->
    <package android:name="com.xiaomi.wearable" />
    <package android:name="com.xiaomi.hm.health" />
    <package android:name="com.huami.watch.hmwatchmanager" />
    <intent>
      <action android:name="android.health.connect.action.HEALTH_HOME_SETTINGS" />
    </intent>
    <intent>
      <action android:name="androidx.health.ACTION_HEALTH_CONNECT_SETTINGS" />
    </intent>
  </queries>
  <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:theme="@style/FastLoopTheme"
      android:hardwareAccelerated="true"
      android:allowBackup="false">
    <activity
        android:name="app.fastloop.MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
        Health Connect will not hand out a health permission to an app that
        cannot explain why it wants one. Below Android 14 it looks for this
        action; without it the permission screen simply never opens, which
        is what the button pressing and nothing happening was.
      -->
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>

    <!--
      The same requirement on Android 14 and up, where health permissions
      became platform permissions and the system asks through this instead.
      It points at the activity that is already here rather than adding
      another: the explanation is the same explanation.
    -->
    <activity-alias
        android:name="app.fastloop.ViewPermissionUsageActivity"
        android:targetActivity="app.fastloop.MainActivity"
        android:exported="true"
        android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>

    <receiver
        android:name="app.fastloop.TimerWidget"
        android:label="@string/widget_timer_name"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_timer_info" />
    </receiver>

    <receiver
        android:name="app.fastloop.SummaryWidget"
        android:label="@string/widget_summary_name"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_summary_info" />
    </receiver>

    <receiver
        android:name="app.fastloop.RingWidget"
        android:label="@string/widget_ring_name"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_ring_info" />
    </receiver>
  </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark theme: the same near-black the widgets use, so icon and widget sitting
  together on the home screen read as one thing.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:type="linear"
      android:angle="315"
      android:startColor="#101A2B"
      android:centerColor="#0A1120"
      android:endColor="#05070C" />
</shape>

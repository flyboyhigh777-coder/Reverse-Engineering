<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background layer: it fills the whole 108dp canvas
     and the launcher crops it to whatever shape the phone uses. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:type="linear"
      android:angle="315"
      android:startColor="#16404A"
      android:endColor="#0E7C7B" />
</shape>

<!--
  "Капля времени": an open ring with the starting dot at twelve, like the
  hand of a stopwatch that has just been pressed.

  Everything sits inside the central 72dp circle of the 108dp canvas — the
  only region every launcher mask keeps. The arc reaches 31.5dp from centre
  and the dot 33.5dp, against a 36dp limit.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <path
      android:pathData="M54,28 a26,26 0 1,0 26,26"
      android:fillColor="#00000000"
      android:strokeColor="#F4F7F6"
      android:strokeWidth="11"
      android:strokeLineCap="round" />

  <path
      android:pathData="M54,28 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 z"
      android:fillColor="#F2A33C" />
</vector>

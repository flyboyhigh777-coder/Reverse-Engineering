<!--
  A fork standing inside the ring, centred.

  It used to stand on the free end of the arc at twelve, which threw the
  whole drawing's weight down and to the right and left the tines looking
  glued to the edge. Everything now lives inside a circle of radius 33 about
  the centre, which no launcher mask crops: the guaranteed-visible area of a
  108dp adaptive icon is the central 72dp.

  Dark ink on lime, matching the app's own buttons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Three quarters of a ring, opening at the lower left. -->
  <path
      android:pathData="M49.1,26.4 A28,28 0 1 1 26.4,58.9"
      android:fillColor="#00000000"
      android:strokeColor="#14280B"
      android:strokeWidth="8"
      android:strokeLineCap="round" />


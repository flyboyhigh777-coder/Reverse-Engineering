    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <group
      android:pivotX="54"
      android:pivotY="54"
      android:scaleX="0.88"
      android:scaleY="0.88">

    <path
        android:pathData="M54,33 a21,21 0 1,0 21,21"
        android:fillColor="#00000000"
        android:strokeColor="#F4F7F6"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M47.5,18.5 L47.5,27.5"

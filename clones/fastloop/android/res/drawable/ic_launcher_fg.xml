<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground layer. Everything stays inside the central 72dp circle of
  the 108dp canvas: that is the only region every launcher mask is
  guaranteed to keep, and a circular mask is the one this icon is drawn for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Dial -->
  <path
      android:pathData="M54,28 a26,26 0 1,0 0.1,0 z"
      android:fillColor="#00000000"
      android:strokeColor="#5FD9C6"
      android:strokeWidth="7" />

  <!-- Hands: a little past ten, so neither covers the fork -->
  <path
      android:pathData="M54,54 L54,38"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="6"
      android:strokeLineCap="round" />
  <path
      android:pathData="M54,54 L65.5,61"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="6"
      android:strokeLineCap="round" />

  <!-- Fork, sitting where the ten would be -->
  <path
      android:pathData="M39,33 L39,44"
      android:fillColor="#00000000"
      android:strokeColor="#F2A33C"
      android:strokeWidth="4"
      android:strokeLineCap="round" />
  <path
      android:pathData="M45,33 L45,44"
      android:fillColor="#00000000"
      android:strokeColor="#F2A33C"
      android:strokeWidth="4"
      android:strokeLineCap="round" />
  <path
      android:pathData="M42,44 L42,55"
      android:fillColor="#00000000"
      android:strokeColor="#F2A33C"
      android:strokeWidth="4"
      android:strokeLineCap="round" />
</vector>

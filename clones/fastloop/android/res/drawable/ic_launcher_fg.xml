<?xml version="1.0" encoding="utf-8"?>
<!--
  A fork standing inside a dial: time and food in one mark.

  The ring is closed rather than open. An open arc reads better large, but
  it pulls the fork visually off-centre at the sizes a launcher actually
  draws, and at 48dp the gap and the tines compete for the same few pixels.

  Everything stays inside the central 72dp circle of the 108dp canvas, the
  only region every launcher mask keeps: the ring reaches 31.75dp from
  centre against a 36dp limit.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <path
      android:pathData="M54,27 a27,27 0 1,0 0.1,0 z"
      android:fillColor="#00000000"
      android:strokeColor="#F4F7F6"
      android:strokeWidth="9.5" />

  <path
      android:pathData="M46,38 L46,51"
      android:fillColor="#00000000"
      android:strokeColor="#F2A33C"
      android:strokeWidth="5"
      android:strokeLineCap="round" />
  <path
      android:pathData="M54,38 L54,51"
      android:fillColor="#00000000"
      android:strokeColor="#F2A33C"
      android:strokeWidth="5"
      android:strokeLineCap="round" />
  <path
      android:pathData="M62,38 L62,51"
      android:fillColor="#00000000"
      android:strokeColor="#F2A33C"
      android:strokeWidth="5"
      android:strokeLineCap="round" />
  <path
      android:pathData="M54,51 L54,70"
      android:fillColor="#00000000"
      android:strokeColor="#F2A33C"
      android:strokeWidth="6.5"
      android:strokeLineCap="round" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Progress bar in the app's own colours; the platform default would be
     the launcher's accent, which has nothing to do with this app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@android:id/background">
    <shape android:shape="rectangle">
      <solid android:color="@color/w_track" />
      <corners android:radius="4dp" />
    </shape>
  </item>
  <item android:id="@android:id/progress">
    <clip>
      <shape android:shape="rectangle">
        <solid android:color="@color/w_accent" />
        <corners android:radius="4dp" />
      </shape>
    </clip>
  </item>
</layer-list>

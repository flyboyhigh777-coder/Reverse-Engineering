<?xml version="1.0" encoding="utf-8"?>
<!-- The rail carries its own hue even when empty; the fill is the same hue
     turned up. Radius matches half the height, so both ends are capsules. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@android:id/background">
    <shape android:shape="rectangle">
      <solid android:color="@color/w_track_lime" />
      <corners android:radius="6dp" />
    </shape>
  </item>
  <item android:id="@android:id/progress">
    <clip>
      <shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#7FCF2A" android:endColor="@color/w_accent" />
        <corners android:radius="6dp" />
      </shape>
    </clip>
  </item>
</layer-list>

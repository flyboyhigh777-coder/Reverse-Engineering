<?xml version="1.0" encoding="utf-8"?>
<!--
  Near-black card with a cold lift towards the top left, so the surface has
  somewhere to come from instead of being a flat rectangle. The hairline is
  what keeps it from dissolving into a dark wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:type="linear"
      android:angle="315"
      android:startColor="#101A2B"
      android:centerColor="#0A1120"
      android:endColor="#06090F" />
  <corners android:radius="24dp" />
  <stroke android:width="1dp" android:color="@color/w_line" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The halo under the time. RemoteViews text cannot carry a shadow layer, so
  the glow is a radial gradient sitting behind it — low alpha, wide radius,
  enough to read as light coming off the digits rather than as a blob.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:type="radial"
      android:gradientRadius="130dp"
      android:centerX="0.32"
      android:centerY="0.5"
      android:startColor="@color/w_glow"
      android:endColor="#00C6F94F" />
</shape>

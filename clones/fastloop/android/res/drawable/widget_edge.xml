<?xml version="1.0" encoding="utf-8"?>
<!-- The lit strip along the bottom: lime into cyan into violet, the three
     hues the rows use, so the widget is signed by its own palette. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:type="linear"
      android:angle="0"
      android:startColor="@color/w_accent"
      android:centerColor="@color/w_cyan"
      android:endColor="@color/w_violet" />
  <corners android:radius="2dp" />
</shape>

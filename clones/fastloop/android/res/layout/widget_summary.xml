<?xml version="1.0" encoding="utf-8"?>
<!--
  The wide widget: the fast, and the three things counted daily.

  Each row is a label on the left and its number on the right rather than one
  run-on string: left-aligned, "Вода 0 / 1900 мл" left most of the row empty
  and the rail below it read as an unexplained slab. Split, the row spans its
  width and the number lands where the eye already goes, in the colour of its
  own rail. Chronometer has no autoSizeTextType, hence fixed sizes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="horizontal"
      android:padding="15dp"
      android:baselineAligned="false">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.08"
        android:orientation="vertical"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/plan"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="12sp"
          android:textAllCaps="true"
          android:letterSpacing="0.08"
          android:textColor="@color/w_cyan"
          android:text="FastLoop" />
      <Chronometer
          android:id="@+id/clock"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:textSize="40sp"
          android:textStyle="bold"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:textColor="@color/w_accent"
          android:format="%s" />
      <TextView
          android:id="@+id/idle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:textSize="40sp"
          android:textStyle="bold"
          android:includeFontPadding="false"
          android:textColor="@color/w_accent"
          android:visibility="gone" />
      <TextView
          android:id="@+id/caption"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textSize="13sp"
          android:textColor="@color/w_ink_3"
          android:text="не запущено" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="13dp"
        android:orientation="vertical">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">
          <TextView
              android:id="@+id/row1"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:textSize="14sp"
              android:singleLine="true"
              android:textColor="@color/w_ink_2"
              android:text="Вода" />
          <TextView
              android:id="@+id/val1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:textSize="15sp"
              android:textStyle="bold"
              android:singleLine="true"
              android:textColor="@color/w_cyan"
              android:text="—" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/bar1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_bar_cyan" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">
          <TextView
              android:id="@+id/row2"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:textSize="14sp"
              android:singleLine="true"
              android:textColor="@color/w_ink_2"
              android:text="Шаги" />
          <TextView
              android:id="@+id/val2"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:textSize="15sp"
              android:textStyle="bold"
              android:singleLine="true"
              android:textColor="@color/w_warm"
              android:text="—" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/bar2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_bar_warm" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">
          <TextView
              android:id="@+id/row3"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:textSize="14sp"
              android:singleLine="true"
              android:textColor="@color/w_ink_2"
              android:text="Калории" />
          <TextView
              android:id="@+id/val3"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:textSize="15sp"
              android:textStyle="bold"
              android:singleLine="true"
              android:textColor="@color/w_accent"
              android:text="—" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/bar3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_bar" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>

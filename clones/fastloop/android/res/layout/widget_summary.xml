<?xml version="1.0" encoding="utf-8"?>
<!--
  The wide widget: the fast plus the three things counted daily.

  The rows carry layout_weight so they spread across whatever height the
  launcher gives the widget, instead of huddling in the middle of it. Sizes
  are fixed rather than auto-sizing because Chronometer, unlike TextView,
  has no autoSizeTextType.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    android:baselineAligned="false">

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1.15"
      android:orientation="vertical"
      android:gravity="center_vertical">
    <TextView
        android:id="@+id/plan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:textColor="@color/w_ink_3"
        android:text="FastLoop" />
    <Chronometer
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="32sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/w_ink"
        android:format="%s" />
    <TextView
        android:id="@+id/idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="32sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:textColor="@color/w_ink"
        android:visibility="gone" />
    <TextView
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="13sp"
        android:textColor="@color/w_ink_2"
        android:text="не запущено" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginStart="14dp"
      android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/row1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/w_ink_2"
          android:text="Вода" />
      <ProgressBar
          android:id="@+id/bar1"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="9dp"
          android:layout_marginTop="4dp"
          android:max="100"
          android:progressDrawable="@drawable/widget_bar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/row2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/w_ink_2"
          android:text="Шаги" />
      <ProgressBar
          android:id="@+id/bar2"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="9dp"
          android:layout_marginTop="4dp"
          android:max="100"
          android:progressDrawable="@drawable/widget_bar_warm" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/row3"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/w_ink_2"
          android:text="Калории" />
      <ProgressBar
          android:id="@+id/bar3"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="9dp"
          android:layout_marginTop="4dp"
          android:max="100"
          android:progressDrawable="@drawable/widget_bar" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Same value as the stylesheet's background token, so the window does
       not flash a different colour before the page paints. -->
  <color name="window_bg">#FFFFFF</color>

  <!--
    Widget palette — neon, and deliberately the same in values/ and
    values-night/. The widget sits on a wallpaper, not on a page: a card
    that turns white in the daytime theme becomes a lamp on a dark home
    screen, which is exactly what this design is not. So it stays dark in
    both, and the brightness lives in the lines rather than the surface.
  -->
  <color name="w_surface">#080C14</color>
  <color name="w_surface_2">#0E1524</color>
  <color name="w_ink">#DFF7FF</color>
  <color name="w_ink_2">#9FB6C4</color>
  <color name="w_ink_3">#6D8495</color>
  <color name="w_accent">#C6F94F</color>
  <color name="w_cyan">#27E0C4</color>
  <color name="w_warm">#FFB020</color>
  <color name="w_violet">#8E6BFF</color>
  <color name="w_track">#17212F</color>
  <!--
    A rail keeps its own colour even when nothing has filled it.

    Empty, a neutral track is a grey slab: three of them stacked read as
    three unexplained rectangles rather than as water, steps and calories
    waiting to be filled. Tinted, an untouched gauge still says which gauge
    it is, and the lit part reads as the same colour switched on.
  -->
  <color name="w_track_lime">#33C6F94F</color>
  <color name="w_track_cyan">#3327E0C4</color>
  <color name="w_track_warm">#33FFB020</color>
  <color name="w_line">#1C2A3C</color>
  <color name="w_glow">#38C6F94F</color>
</resources>

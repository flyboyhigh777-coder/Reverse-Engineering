{
  "name": "fastloop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Intermittent fasting tracker: timer, calorie diary, recipes and evidence-labelled fasting windows.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "artifact": "npm run build && node scripts/make-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
